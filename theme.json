{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "black", "color": "#0a0a0a", "name": "Black" },
        { "slug": "deep", "color": "#111118", "name": "Deep" },
        { "slug": "surface", "color": "#16161f", "name": "Surface" },
        { "slug": "white", "color": "#f0f0f0", "name": "White" },
        { "slug": "accent", "color": "#c8ff00", "name": "Accent" },
        { "slug": "purple", "color": "#7c3aed", "name": "Purple" },
        { "slug": "blue", "color": "#3b82f6", "name": "Blue" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "display", "fontFamily": "'Clash Display','Space Grotesk',sans-serif", "name": "Display" },
        { "slug": "body", "fontFamily": "'Space Grotesk',sans-serif", "name": "Body" }
      ],
      "fontSizes": [
        { "slug": "sm", "size": "0.9rem", "name": "Small" },
        { "slug": "base", "size": "1rem", "name": "Base" },
        { "slug": "lg", "size": "1.25rem", "name": "Large" },
        { "slug": "h3", "size": "clamp(1.4rem,3vw,2.5rem)", "name": "H3" },
        { "slug": "h2", "size": "clamp(2rem,5vw,5rem)", "name": "H2" },
        { "slug": "h1", "size": "clamp(3rem,8vw,8rem)", "name": "H1" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "sm", "size": "20px", "name": "Small" },
        { "slug": "md", "size": "40px", "name": "Medium" },
        { "slug": "lg", "size": "80px", "name": "Large" },
        { "slug": "xl", "size": "120px", "name": "XL" }
      ]
    },
    "custom": {
      "radius": { "sm": "12px", "md": "20px", "lg": "32px", "xl": "48px" },
      "transition": "all 0.4s cubic-bezier(0.16,1,0.3,1)"
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--black)", "text": "var(--wp--preset--color--white)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)" },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700" } },
      "link": { "color": { "text": "var(--wp--preset--color--white)" } }
    }
  }
}
